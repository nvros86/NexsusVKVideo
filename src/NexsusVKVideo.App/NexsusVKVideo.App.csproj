<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Web.WebView2" GeneratePathProperty="true" />
  </ItemGroup>
  <ItemGroup>
    <!-- The WebView2 package's target does not yet recognise net10.0-windows; use its documented managed assemblies explicitly. -->
    <Reference Include="Microsoft.Web.WebView2.Core">
      <HintPath>$(PkgMicrosoft_Web_WebView2)\lib_manual\netcoreapp3.0\Microsoft.Web.WebView2.Core.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.Web.WebView2.Wpf">
      <HintPath>$(PkgMicrosoft_Web_WebView2)\lib_manual\net5.0-windows10.0.17763.0\Microsoft.Web.WebView2.Wpf.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\NexsusVKVideo.Core\NexsusVKVideo.Core.csproj" />
    <ProjectReference Include="..\NexsusVKVideo.Infrastructure\NexsusVKVideo.Infrastructure.csproj" />
    <ProjectReference Include="..\NexsusVKVideo.Modules\NexsusVKVideo.Modules.csproj" />
  </ItemGroup>
</Project>
