<Window x:Class="NexsusVKVideo.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:NexsusVKVideo.App.ViewModels"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="NexsusVKVideo" Width="1600" Height="1000" MinWidth="960" MinHeight="640"
        Background="{DynamicResource Brush.Background}" Foreground="{DynamicResource Brush.TextPrimary}"
        FontFamily="Segoe UI" SnapsToDevicePixels="True" UseLayoutRounding="True" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <DataTemplate DataType="{x:Type vm:HomePageViewModel}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24">
                    <TextBlock Text="{Binding Title}" FontSize="28" FontWeight="SemiBold" />
                    <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource Brush.TextSecondary}" Text="{Binding Description}" TextWrapping="Wrap" />
                    <Border Margin="0,24" Padding="24" Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="12">
                        <StackPanel>
                            <TextBlock Foreground="{DynamicResource Brush.Accent}" FontWeight="SemiBold" Text="ДЕМОНСТРАЦИОННЫЙ КАТАЛОГ" />
                            <TextBlock Margin="0,8,0,0" FontSize="22" FontWeight="SemiBold" Text="Интерфейс без сетевых данных" />
                            <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource Brush.TextSecondary}" Text="Все карточки ниже созданы только для проверки навигации и состояний. Они не представляют VK Video." TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <TextBlock Margin="0,0,0,16" FontSize="22" FontWeight="SemiBold" Text="Карточки" />
                    <ItemsControl ItemsSource="{Binding Videos}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Width="240" AutomationProperties.Name="{Binding Title}" Command="{Binding DataContext.OpenDemoCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource VideoCardButtonStyle}">
                                    <StackPanel>
                                        <Border Height="120" Background="{DynamicResource Brush.Surface}" CornerRadius="8">
                                            <Grid>
                                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextSecondary}" Text="{Binding Badge}" TextAlignment="Center" TextWrapping="Wrap" />
                                                <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8" Padding="6,2" Background="{DynamicResource Brush.Background}" CornerRadius="999"><TextBlock FontSize="12" Text="{Binding Duration}" /></Border>
                                            </Grid>
                                        </Border>
                                        <TextBlock Margin="0,12,0,0" FontWeight="SemiBold" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource Brush.TextSecondary}" Text="{Binding Creator}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PlaceholderPageViewModel}">
            <Grid Margin="24"><StackPanel MaxWidth="640" VerticalAlignment="Center">
                <TextBlock FontSize="28" FontWeight="SemiBold" Text="{Binding Title}" />
                <TextBlock Margin="0,16,0,0" Foreground="{DynamicResource Brush.TextSecondary}" Text="{Binding Description}" TextWrapping="Wrap" />
                <Border Margin="0,24,0,0" Padding="16" Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="12"><TextBlock Foreground="{DynamicResource Brush.TextSecondary}" Text="{Binding ActionHint}" TextWrapping="Wrap" /></Border>
            </StackPanel></Grid>
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="224" /><ColumnDefinition Width="*" /><ColumnDefinition Width="400" /></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0">
            <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="80" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel Grid.Row="0"><TextBlock FontSize="24" FontWeight="SemiBold"><Run Text="Nexsus" /><Run Foreground="{DynamicResource Brush.Accent}" Text="VK" /><Run Text="Video" /></TextBlock><TextBlock Margin="0,6,0,0" Foreground="{DynamicResource Brush.TextSecondary}" Text="Этап 0.1" /></StackPanel>
                <ListBox Grid.Row="1" AutomationProperties.Name="Навигация" ItemsSource="{Binding NavigationItems}" SelectedItem="{Binding SelectedNavigation, Mode=TwoWay}" Style="{StaticResource NavigationListStyle}">
                    <ListBox.ItemContainerStyle><StaticResource ResourceKey="NavigationListItemStyle" /></ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><TextBlock Width="28" FontSize="20" Text="{Binding Glyph}" /><TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="{Binding Title}" /></StackPanel></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Grid.Row="3" Margin="16" Foreground="{DynamicResource Brush.TextSecondary}" Text="Демо-данные. Интеграция VK не заявляется." TextWrapping="Wrap" />
            </Grid>
        </Border>
        <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="76" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Border Grid.Row="0" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1"><Grid Margin="24,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Height="40" IsReadOnly="True" AutomationProperties.Name="Поиск видео" Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.Border}" Foreground="{DynamicResource Brush.TextSecondary}" Padding="12,8" Text="Поиск станет доступен после подключения документированного провайдера" ToolTip="Поиск ещё не выполняет сетевые запросы." />
                <TextBlock Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" Text="Гость" />
            </Grid></Border>
            <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" />
        </Grid>
        <Border Grid.Column="2" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1,0,0,0">
            <StackPanel Margin="16"><TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding Player.Title}" />
                <Border Margin="0,16,0,0" Padding="16" Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="12"><StackPanel><TextBlock FontWeight="SemiBold" Text="{Binding Player.Status}" /><TextBlock Margin="0,8,0,0" Foreground="{DynamicResource Brush.TextSecondary}" Text="{Binding Player.Message}" TextWrapping="Wrap" /></StackPanel></Border>
                <Border Margin="0,16,0,0" Height="230" Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="12" ClipToBounds="True" Visibility="{Binding Player.HasEmbed, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <wv2:WebView2 x:Name="PlayerWebView" />
                </Border>
                <Button Margin="0,16,0,0" Padding="12,8" Command="{Binding Player.OpenInBrowserCommand}" Content="Открыть в системном браузере" ToolTip="Открывает только подтверждённую страницу vk.ru для текущего виджета." />
                <Button Margin="0,12,0,0" Padding="12,8" Command="{Binding Player.ClearCommand}" Content="Закрыть сценарий" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
