<Window x:Class="NexsusVKVideo.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:NexsusVKVideo.App.ViewModels"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="NexsusVKVideo" Width="1280" Height="800" MinWidth="960" MinHeight="640"
        Background="{DynamicResource Brush.Background}" Foreground="{DynamicResource Brush.TextPrimary}"
        FontFamily="Segoe UI" SnapsToDevicePixels="True" UseLayoutRounding="True" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <DataTemplate DataType="{x:Type vm:HomePageViewModel}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24">
                    <TextBlock Text="{Binding Title}" FontSize="28" FontWeight="SemiBold" />
                    <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource Brush.TextSecondary}" Text="{Binding Description}" TextWrapping="Wrap" />
                    <Border Margin="0,24" Padding="24" Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="12">
                        <StackPanel>
                            <TextBlock Foreground="{DynamicResource Brush.Accent}" FontWeight="SemiBold" Text="ДЕМОНСТРАЦИОННЫЙ КАТАЛОГ" />
                            <TextBlock Margin="0,8,0,0" FontSize="22" FontWeight="SemiBold" Text="Интерфейс без сетевых данных" />
                            <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource Brush.TextSecondary}" Text="Все карточки ниже созданы только для проверки навигации и состояний. Они не представляют VK Video." TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <TextBlock Margin="0,0,0,16" FontSize="22" FontWeight="SemiBold" Text="Карточки" />
                    <ItemsControl ItemsSource="{Binding Videos}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Width="240" AutomationProperties.Name="{Binding Title}" Command="{Binding DataContext.OpenDemoCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource VideoCardButtonStyle}">
                                    <StackPanel>
                                        <Border Height="120" Background="{DynamicResource Brush.Surface}" CornerRadius="8">
                                            <Grid>
                                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextSecondary}" Text="{Binding Badge}" TextAlignment="Center" TextWrapping="Wrap" />
                                                <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8" Padding="6,2" Background="{DynamicResource Brush.Background}" CornerRadius="999"><TextBlock FontSize="12" Text="{Binding Duration}" /></Border>
                                            </Grid>
                                        </Border>
                                        <TextBlock Margin="0,12,0,0" FontWeight="SemiBold" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource Brush.TextSecondary}" Text="{Binding Creator}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PlaceholderPageViewModel}">
            <Grid Margin="24"><StackPanel MaxWidth="640" VerticalAlignment="Center">
                <TextBlock FontSize="28" FontWeight="SemiBold" Text="{Binding Title}" />
                <TextBlock Margin="0,16,0,0" Foreground="{DynamicResource Brush.TextSecondary}" Text="{Binding Description}" TextWrapping="Wrap" />
                <Border Margin="0,24,0,0" Padding="16" Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="12"><TextBlock Foreground="{DynamicResource Brush.TextSecondary}" Text="{Binding ActionHint}" TextWrapping="Wrap" /></Border>
            </StackPanel></Grid>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ImportPageViewModel}">
            <Grid Margin="24"><StackPanel MaxWidth="720" VerticalAlignment="Center">
                <TextBlock FontSize="28" FontWeight="SemiBold" Text="{Binding Title}" />
                <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource Brush.TextSecondary}" Text="{Binding Description}" TextWrapping="Wrap" />
                <Border Margin="0,24,0,0" Padding="20" Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="12">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="Публичная ссылка" />
                        <TextBox Margin="0,10,0,0" Height="42" AutomationProperties.Name="Публичная ссылка VK Video" Padding="12,8" Text="{Binding LinkText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Например: https://vk.ru/video-22822305_456241864">
                            <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding ImportCommand}" /></TextBox.InputBindings>
                        </TextBox>
                        <Button Margin="0,12,0,0" Padding="12,8" HorizontalAlignment="Left" AutomationProperties.Name="Открыть ссылку VK Video" Command="{Binding ImportCommand}" Content="Открыть во встроенном плеере" />
                        <TextBlock Margin="0,12,0,0" Foreground="{DynamicResource Brush.TextSecondary}" Text="Пример: https://vk.ru/video-22822305_456241864" TextWrapping="Wrap" />
                        <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource Brush.TextSecondary}" Text="Никакой API-ключ, токен или cookie в приложение не передаётся." TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <TextBlock Margin="0,16,0,0" Foreground="{DynamicResource Brush.TextSecondary}" Text="{Binding Message}" TextWrapping="Wrap" />
            </StackPanel></Grid>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LibraryPageViewModel}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24">
                    <TextBlock FontSize="28" FontWeight="SemiBold" Text="{Binding Title}" />
                    <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource Brush.TextSecondary}" Text="{Binding Description}" TextWrapping="Wrap" />
                    <StackPanel Margin="0,24,0,0" Orientation="Horizontal">
                        <Button Padding="12,8" AutomationProperties.Name="Обновить историю" Command="{Binding RefreshCommand}" Content="Обновить" />
                        <Button Margin="12,0,0,0" Padding="12,8" AutomationProperties.Name="Очистить историю" Command="{Binding ClearCommand}" Content="Очистить историю" />
                    </StackPanel>
                    <TextBlock Margin="0,16,0,0" Foreground="{DynamicResource Brush.TextSecondary}" Text="{Binding Message}" TextWrapping="Wrap" />
                    <Border Margin="0,16,0,0" Padding="16" Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="12">
                        <ItemsControl ItemsSource="{Binding Entries}">
                            <ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock FontWeight="SemiBold" Text="{Binding Video.Title}" /><TextBlock Margin="0,4,0,0" Foreground="{DynamicResource Brush.TextSecondary}" Text="{Binding Video.Key.Provider}" /></StackPanel>
                                <TextBlock Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextSecondary}" Text="{Binding WatchedAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}" />
                            </Grid></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:FavoritesPageViewModel}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24">
                    <TextBlock FontSize="28" FontWeight="SemiBold" Text="{Binding Title}" />
                    <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource Brush.TextSecondary}" Text="{Binding Description}" TextWrapping="Wrap" />
                    <Button Margin="0,24,0,0" Padding="12,8" HorizontalAlignment="Left" AutomationProperties.Name="Обновить избранное" Command="{Binding RefreshCommand}" Content="Обновить" />
                    <TextBlock Margin="0,16,0,0" Foreground="{DynamicResource Brush.TextSecondary}" Text="{Binding Message}" TextWrapping="Wrap" />
                    <Border Margin="0,16,0,0" Padding="16" Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="12">
                        <ItemsControl ItemsSource="{Binding Videos}">
                            <ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock FontWeight="SemiBold" Text="{Binding Title}" /><TextBlock Margin="0,4,0,0" Foreground="{DynamicResource Brush.TextSecondary}" Text="{Binding Key.Provider}" /></StackPanel>
                                <Button Grid.Column="1" Margin="16,0,0,0" Padding="12,8" VerticalAlignment="Center" AutomationProperties.Name="Удалить из избранного" Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Content="Удалить" />
                            </Grid></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsPageViewModel}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24" MaxWidth="720">
                    <TextBlock FontSize="28" FontWeight="SemiBold" Text="{Binding Title}" />
                    <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource Brush.TextSecondary}" Text="{Binding Description}" TextWrapping="Wrap" />
                    <Border Margin="0,24,0,0" Padding="16" Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="12">
                        <StackPanel>
                            <TextBlock FontSize="22" FontWeight="SemiBold" Text="Оформление" />
                            <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource Brush.TextSecondary}" Text="Тема применяется сразу и сохраняется для следующих запусков." TextWrapping="Wrap" />
                            <StackPanel Margin="0,16,0,0" Orientation="Horizontal">
                                <ComboBox Width="180" Height="40" AutomationProperties.Name="Тема приложения" ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding SelectedTheme, Mode=TwoWay}" />
                                <Button Margin="12,0,0,0" Padding="12,8" Command="{Binding SaveThemeCommand}" Content="Применить тему" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Margin="0,16,0,0" Padding="16" Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="12">
                        <StackPanel>
                            <TextBlock FontSize="22" FontWeight="SemiBold" Text="Приватность и данные" />
                            <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource Brush.TextSecondary}" Text="История и избранное находятся только в локальном профиле. Приложение не сохраняет пароль VK, токены или cookies в SQLite." TextWrapping="Wrap" />
                            <Button Margin="0,16,0,0" Padding="12,8" HorizontalAlignment="Left" AutomationProperties.Name="Очистить историю на устройстве" Command="{Binding ClearHistoryCommand}" Content="Очистить историю" />
                            <TextBlock Margin="0,16,0,0" Foreground="{DynamicResource Brush.TextSecondary}" Text="Очистка данных плеера удалит кэш и сессии WebView2 при следующем запуске. Это может потребовать повторной авторизации на стороне VK." TextWrapping="Wrap" />
                            <Button Margin="0,12,0,0" Padding="12,8" HorizontalAlignment="Left" AutomationProperties.Name="Очистить данные встроенного плеера после перезапуска" Command="{Binding ScheduleWebViewResetCommand}" Content="Очистить данные плеера после перезапуска" />
                        </StackPanel>
                    </Border>
                    <TextBlock Margin="0,16,0,0" Foreground="{DynamicResource Brush.TextSecondary}" Text="{Binding Message}" TextWrapping="Wrap" />
                    <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource Brush.TextSecondary}" Text="Версия схемы локальных настроек: 1" />
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="224" /><ColumnDefinition Width="*" /><ColumnDefinition Width="400" /></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0" Visibility="{Binding IsMainShellVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="80" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel Grid.Row="0"><TextBlock FontSize="24" FontWeight="SemiBold"><Run Text="Nexsus" /><Run Foreground="{DynamicResource Brush.Accent}" Text="VK" /><Run Text="Video" /></TextBlock><TextBlock Margin="0,6,0,0" Foreground="{DynamicResource Brush.TextSecondary}" Text="Этап 0.2" /></StackPanel>
                <ListBox Grid.Row="1" AutomationProperties.Name="Навигация" ItemsSource="{Binding NavigationItems}" SelectedItem="{Binding SelectedNavigation, Mode=TwoWay}" Style="{StaticResource NavigationListStyle}">
                    <ListBox.ItemContainerStyle><StaticResource ResourceKey="NavigationListItemStyle" /></ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><TextBlock Width="28" FontSize="20" Text="{Binding Glyph}" /><TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="{Binding Title}" /></StackPanel></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Grid.Row="3" Margin="16" Foreground="{DynamicResource Brush.TextSecondary}" Text="Демо-данные. Интеграция VK не заявляется." TextWrapping="Wrap" />
            </Grid>
        </Border>
        <Grid Grid.Column="1" Visibility="{Binding IsMainShellVisible, Converter={StaticResource BooleanToVisibilityConverter}}"><Grid.RowDefinitions><RowDefinition Height="76" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Border Grid.Row="0" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1"><Grid Margin="24,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Height="40" IsReadOnly="True" AutomationProperties.Name="Импорт публичной ссылки VK Video" Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.Border}" Foreground="{DynamicResource Brush.TextSecondary}" Padding="12,8" Text="Открывайте публичные ссылки VK Video без API-ключей" ToolTip="В разделе «Поиск» поддерживается импорт публичной ссылки VK Video." />
                <TextBlock Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" Text="Гость" />
            </Grid></Border>
            <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" />
        </Grid>
        <Border Grid.Column="2" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1,0,0,0" Visibility="{Binding IsMainShellVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel Margin="16"><TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding Player.Title}" />
                <Border Margin="0,16,0,0" Padding="16" Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="12"><StackPanel><TextBlock FontWeight="SemiBold" Text="{Binding Player.Status}" /><TextBlock Margin="0,8,0,0" Foreground="{DynamicResource Brush.TextSecondary}" Text="{Binding Player.Message}" TextWrapping="Wrap" /></StackPanel></Border>
                <Border Margin="0,16,0,0" Height="230" Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="12" ClipToBounds="True" Visibility="{Binding Player.HasEmbed, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <wv2:WebView2 x:Name="PlayerWebView" />
                </Border>
                <Button Margin="0,16,0,0" Padding="12,8" Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Player.CurrentVideo}" Content="{Binding Player.FavoriteButtonText}" ToolTip="Сохраняет только поддерживаемое видео в локальном избранном." />
                <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource Brush.Error}" Text="{Binding Player.DataMessage}" TextWrapping="Wrap" />
                <Button Margin="0,16,0,0" Padding="12,8" Command="{Binding Player.OpenInBrowserCommand}" Content="Открыть в системном браузере" ToolTip="Открывает только подтверждённую страницу vk.ru для текущего виджета." />
                <Button Margin="0,12,0,0" Padding="12,8" Command="{Binding Player.ClearCommand}" Content="Закрыть сценарий" />
            </StackPanel>
        </Border>
        <Border Grid.Column="0" Grid.ColumnSpan="3" Background="{DynamicResource Brush.Background}" Visibility="{Binding IsBrowserMode, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <wv2:WebView2 x:Name="BrowserWebView" Grid.Row="0" />
                <TextBlock Grid.Row="1" Margin="24,8" Foreground="{DynamicResource Brush.Error}" Text="{Binding CurrentPage.Message}" TextWrapping="Wrap" />
            </Grid>
        </Border>
    </Grid>
</Window>
