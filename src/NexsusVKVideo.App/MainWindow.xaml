<Window x:Class="NexsusVKVideo.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="VK Video" Width="1280" Height="800" MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen" SnapsToDevicePixels="True" UseLayoutRounding="True">
    <Grid>
        <wv2:WebView2 x:Name="BrowserWebView" />
        <Border x:Name="BrowserErrorPanel" Padding="24" Background="#EE101A2B" Visibility="Collapsed">
            <TextBlock x:Name="BrowserErrorText" MaxWidth="640" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#EAF2FF" TextAlignment="Center" TextWrapping="Wrap" />
        </Border>
    </Grid>
</Window>
